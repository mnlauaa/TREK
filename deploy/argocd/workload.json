    },
    "spec": {
      "progressDeadlineSeconds": 900,
      "replicas": 1,
      "revisionHistoryLimit": 10,
      "selector": {
        "matchLabels": {
          "app": "trek"
        }
      },
      "strategy": {
        "type": "Recreate"
      },
      "template": {
