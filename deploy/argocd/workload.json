            "checksum/secret": "91ebcd7c63e01a067d30778704921d2184d5ff83adeb8cb13f46e19854379679"
          },
          "labels": {
            "app": "trek"
          }
        },
        "spec": {
          "containers": [
            {
              "env": [
                {
                  "name": "ENCRYPTION_KEY",
                  "valueFrom": {
                    "secretKeyRef": {
                      "key": "ENCRYPTION_KEY",
                      "name": "trek-secret",
                      "optional": true
                    }
                  }
                },
                {
                  "name": "ADMIN_EMAIL",
                  "valueFrom": {
                    "secretKeyRef": {
                      "key": "ADMIN_EMAIL",
                      "name": "trek-secret",
                      "optional": true
                    }
                  }
                },
                {
                  "name": "ADMIN_PASSWORD",
                  "valueFrom": {
                    "secretKeyRef": {
                      "key": "ADMIN_PASSWORD",
                      "name": "trek-secret",
                      "optional": true
                    }
                  }
                },
                {
                  "name": "OIDC_CLIENT_SECRET",
                  "valueFrom": {
                    "secretKeyRef": {
                      "key": "OIDC_CLIENT_SECRET",
                      "name": "trek-secret",
                      "optional": true
                    }
                  }
                },
                {
                  "name": "UNSPLASH_ACCESS_KEY",
                  "valueFrom": {
                    "secretKeyRef": {
                      "key": "UNSPLASH_ACCESS_KEY",
                      "name": "trek-secret",
                      "optional": true
                    }
                  }
                },
                {
                  "name": "AMAP_API_KEY",
                  "valueFrom": {
                    "secretKeyRef": {
                      "key": "AMAP_API_KEY",
                      "name": "trek-secret",
                      "optional": true
                    }
                  }
                },
                {
                  "name": "AMAP_API_SECRET",
                  "valueFrom": {
                    "secretKeyRef": {
                      "key": "AMAP_API_SECRET",
                      "name": "trek-secret",
                      "optional": true
                    }
                  }
                }
              ],
              "envFrom": [
                {
                  "configMapRef": {
                    "name": "trek-config"
                  }
                }
              ],
              "image": "localhost/trek:sha-2167e593677f397a128e002dba29ba29ce901f56",
              "imagePullPolicy": "Never",
              "livenessProbe": {
                "failureThreshold": 3,
                "httpGet": {
                  "path": "/api/health",
                  "port": 3000,
                  "scheme": "HTTP"
                },
                "initialDelaySeconds": 90,
                "periodSeconds": 30,
                "successThreshold": 1,
                "timeoutSeconds": 1
              },
              "name": "trek",
              "ports": [
                {
                  "containerPort": 3000,
                  "protocol": "TCP"
                }
              ],
              "readinessProbe": {
                "failureThreshold": 3,
                "httpGet": {
                  "path": "/api/health",
                  "port": 3000,
                  "scheme": "HTTP"
                },
                "initialDelaySeconds": 10,
                "periodSeconds": 10,
                "successThreshold": 1,
                "timeoutSeconds": 1
              },
              "resources": {
                "limits": {
                  "cpu": "1",
                  "memory": "768Mi"
                },
                "requests": {
                  "cpu": "100m",
                  "memory": "256Mi"
                }
              },
              "terminationMessagePath": "/dev/termination-log",
              "terminationMessagePolicy": "File",
              "volumeMounts": [
