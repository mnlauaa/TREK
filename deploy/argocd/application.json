{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "argoproj.io/v1alpha1",
      "kind": "AppProject",
      "metadata": {
        "name": "trek",
        "namespace": "argocd"
      },
      "spec": {
        "description": "TREK Lightsail deployment",
        "sourceRepos": [
          "https://github.com/mnlauaa/TREK.git"
        ],
        "destinations": [
          {
            "server": "https://kubernetes.default.svc",
            "namespace": "trek"
          }
        ],
        "clusterResourceWhitelist": [],
        "namespaceResourceWhitelist": [
          {
            "group": "apps",
            "kind": "Deployment"
          },
          {
            "group": "",
            "kind": "ConfigMap"
          },
          {
            "group": "",
            "kind": "Service"
          },
          {
            "group": "batch",
            "kind": "Job"
          },
          {
            "group": "networking.k8s.io",
            "kind": "NetworkPolicy"
          }
        ]
      }
    },
    {
      "apiVersion": "argoproj.io/v1alpha1",
      "kind": "Application",
      "metadata": {
        "name": "trek",
        "namespace": "argocd"
      },
      "spec": {
        "project": "trek",
        "source": {
          "repoURL": "https://github.com/mnlauaa/TREK.git",
          "targetRevision": "gitops",
          "path": "deploy/gitops",
          "directory": {
            "include": "manifests.json"
          }
        },
        "destination": {
          "server": "https://kubernetes.default.svc",
          "namespace": "trek"
        },
        "syncPolicy": {
          "retry": {
            "limit": 0
          },
          "automated": {
            "enabled": false,
            "prune": false,
            "selfHeal": false
          },
          "syncOptions": [
            "FailOnSharedResource=true"
          ]
        },
        "revisionHistoryLimit": 5
      }
    }
  ]
}
